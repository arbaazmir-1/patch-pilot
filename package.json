{
  "name": "patch-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first agent that investigates npm dependency vulnerabilities against your real code and applies human-approved fixes with a full audit trail.",
  "type": "module",
  "license": "MIT",
  "author": "Abdullah",
  "bin": {
    "patch-pilot": "dist/bin/patch-pilot.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=src/.env.local bin/patch-pilot.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/bin/patch-pilot.js', 0o755)\""
  },
  "keywords": [
    "security",
    "vulnerability",
    "npm",
    "osv",
    "ollama",
    "agent",
    "cli"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "ora": "^9.4.1",
    "semver": "^7.8.5",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.6",
    "@types/semver": "^7.8.0"
  },
  "allowScripts": {
    "better-sqlite3": false
  }
}
